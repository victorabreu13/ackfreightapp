# Local Postgres. Cloud Run uses the DATABASE_URL secret from Secret Manager.
DATABASE_URL="postgresql://ack_guias:ack_guias@127.0.0.1:5432/ack_guias?schema=public"

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="http://127.0.0.1:43123"
AUTH_TRUST_HOST="true"
# Production public origin. Overrides the built-in Cloud Run URL.
# Do not set this to the legacy *.a.run.app host.
# APP_URL="https://ack-guias-711303341686.us-east1.run.app"

# Google OAuth web client in the ack-guias Cloud project.
# Redirect: {AUTH_URL}/api/auth/callback/google
# Sign-in is limited to the ackfreight.com Workspace domain.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# These addresses can always sign in, as Admin. Everyone else must be added on Usuarios.
ADMIN_EMAILS="victor.abreu@ackfreight.com,andres.alvarado@ackfreight.com"

# Development sign-in is on when NODE_ENV is not production.
# Set this only to turn that provider on in a production build. Do not set it on Cloud Run.
# ENABLE_DEV_LOGIN="true"

# Optional Drive. Share the root folder with the service account.
# GOOGLE_DRIVE_SA_JSON=""
# ACK_GUIAS_DRIVE_ROOT_ID=""
# ACK_GUIAS_DRIVE_FOLDER="ACK Guías"

# Optional QuickBooks Online. Redirect: {AUTH_URL}/api/guias/qbo/callback
# QBO_TOKEN_KEY is 32 bytes, base64 (openssl rand -base64 32).
# QBO_ENVIRONMENT=sandbox is the default.
# QBO_CLIENT_ID=""
# QBO_CLIENT_SECRET=""
# QBO_TOKEN_KEY=""
# QBO_ENVIRONMENT="sandbox"

# Optional pasted-email parser.
# AI_PARSER_PROVIDER="anthropic"
# AI_PARSER_MODEL="claude-sonnet-4-5"
# AI_PARSER_API_KEY=""
