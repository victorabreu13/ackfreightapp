    function e_4_0(){return resource.data.awbLines.size()>4&&request.resource.data.awbLines.size()>0&&awbDispatchEquals(resource.data.awbLines[4],request.resource.data.awbLines[0]);}
    function e_4_1(){return resource.data.awbLines.size()>4&&request.resource.data.awbLines.size()>1&&awbDispatchEquals(resource.data.awbLines[4],request.resource.data.awbLines[1]);}
