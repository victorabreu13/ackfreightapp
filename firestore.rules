rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users can read/create their own profile. Only the owner can create it
    // (at sign-up); nobody can change their own role after that.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update, delete: if false;
    }

    // Drivers can create and read their own trips. Admins can read every trip.
    // Trips are immutable once created (a log entry, not an editable record).
    match /trips/{tripId} {
      allow create: if isSignedIn() && request.resource.data.driverId == request.auth.uid;
      allow read: if isSignedIn() &&
        (resource.data.driverId == request.auth.uid || isAdmin());
      allow update, delete: if false;
    }
  }
}
