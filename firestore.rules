rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users can read their own profile. Only the owner can create it, and
    // only as a driver or customer — admin is granted later by setUserRole
    // (Admin SDK), never by the client. A user can update their own
    // push-notification token; an admin can set a driver's payroll rate
    // (payType/payRate), a customer's billing rate (billType/billRate), or
    // fix a user's display name. quickbooksCustomerId is written only by
    // the sendQuickBooksInvoice Cloud Function.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'role', 'createdAt'])
        && request.resource.data.uid == userId
        && request.resource.data.role in ['driver', 'customer']
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 200
        && request.resource.data.createdAt is number;
      allow update: if isSignedIn() && (
        (request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["pushToken", "onDuty"]) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(["onDuty"]) ||
            (resource.data.role == "driver" && request.resource.data.onDuty is bool)
          )) ||
        (isAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ["payType", "payRate", "billType", "billRate", "name"])));
      allow delete: if false;
    }

    // Drivers can create and read their own trips. Admins can read every trip
    // and toggle a trip's payroll-paid or invoiced status. Trips can't
    // otherwise be edited or deleted directly by clients — deletion only
    // happens through the deleteTrip Cloud Function, which audits it.
    // The new app submits trips through submitTripLog; direct create stays
    // allowed so already-shipped builds keep working.
    match /trips/{tripId} {
      allow create: if isSignedIn() && request.resource.data.driverId == request.auth.uid;
      allow read: if isSignedIn() &&
        (resource.data.driverId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["paid", "invoiced"]);
      allow delete: if false;
    }

    // Audit trail written only by the deleteTrip Cloud Function (Admin SDK
    // bypasses these rules); admins can review it, nobody can write to it
    // directly from the client.
    match /deletedTrips/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Normalized AWB+ULD claims for duplicate detection. Server only.
    match /tripUldKeys/{keyId} {
      allow read, write: if false;
    }

    // Website leads and the intake rate-limit counters. Dispatch reads leads.
    // Approve and dismiss go through Cloud Functions.
    match /leads/{leadId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /intakeRateLimits/{bucketId} {
      allow read, write: if false;
    }

    // Driver pay agreements and the company default. Admins read them.
    // Clients never write them — Manage Users saves through Cloud Functions,
    // which also logs the change. Drivers cannot read another driver's
    // agreement, or their own (the offer they see is only the dollar amount).
    match /driverPayAgreements/{driverId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /driverPayAgreementLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /config/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Snapshotted pay for one AWB. The assigned driver can read their own
    // document. Customers cannot. Nobody writes it from the client.
    match /awbPay/{payId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.driverId == request.auth.uid);
      allow write: if false;
    }

    match /awbPayOverrides/{payId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /driverPayAudit/{auditId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // QuickBooks OAuth tokens — holds a live access/refresh token pair that
    // could act on the whole connected QuickBooks company, so no client
    // (including admins) ever reads or writes it directly. Only the
    // QuickBooks Cloud Functions touch it, via the Admin SDK.
    match /quickbooksAuth/{docId} {
      allow read, write: if false;
    }

    // Customers submit and own their trip requests; admins (Dispatch) can
    // read, create (on a customer's behalf, e.g. a phone-in order) and update
    // every request. A customer may keep editing route, schedule, notes,
    // cargo fields, and files — including adding or removing AWB lines —
    // right up until a driver actually starts the request. They cannot change
    // driver assignment, line status, or other dispatch-owned fields.
    // Drivers move their own lines forward through Cloud Functions.
    function isOwnTripRequest() {
      return resource.data.customerId == request.auth.uid;
    }

    function isAssignedDriver() {
      return request.auth.uid in resource.data.assignedDriverIds;
    }

    function tripRequestLocked() {
      return resource.data.status in ["in_progress", "completed", "invoiced", "cancelled"];
    }

    function customerImmutableOk() {
      return request.resource.data.assignedDriverIds == resource.data.assignedDriverIds
        && request.resource.data.assignedDriverNames == resource.data.assignedDriverNames
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.customerName == resource.data.customerName
        && request.resource.data.customerEmail == resource.data.customerEmail
        && request.resource.data.submittedAt == resource.data.submittedAt
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && request.resource.data.get('tripLogId', null) == resource.data.get('tripLogId', null)
        && request.resource.data.get('quickbooksInvoiceId', null) == resource.data.get('quickbooksInvoiceId', null)
        && request.resource.data.get('invoicedAt', null) == resource.data.get('invoicedAt', null)
        && request.resource.data.get('driverLocations', {}) == resource.data.get('driverLocations', {})
        && request.resource.data.get('quotedAmount', null) == resource.data.get('quotedAmount', null)
        && request.resource.data.get('quoteStatus', null) == resource.data.get('quoteStatus', null)
        && request.resource.data.get('quoteBasis', null) == resource.data.get('quoteBasis', null)
        && request.resource.data.get('leadId', null) == resource.data.get('leadId', null)
        && request.resource.data.get('routeEstimate', null) == resource.data.get('routeEstimate', null);
    }

    function isFreshAwbLine(line) {
      return line.get('assignedDriverId', null) == null
        && line.get('assignedDriverName', null) == null
        && line.get('status', 'submitted') == 'submitted'
        && line.get('tripLogId', null) == null
        && line.get('startedAt', null) == null
        && line.get('acceptedAt', null) == null
        && line.get('pickedUpAt', null) == null;
    }

    function awbDispatchEquals(oldLine, newLine) {
      return newLine.get('assignedDriverId', null) == oldLine.get('assignedDriverId', null)
        && newLine.get('assignedDriverName', null) == oldLine.get('assignedDriverName', null)
        && newLine.get('status', 'submitted') == oldLine.get('status', 'submitted')
        && newLine.get('tripLogId', null) == oldLine.get('tripLogId', null)
        && newLine.get('startedAt', null) == oldLine.get('startedAt', null)
        && newLine.get('acceptedAt', null) == oldLine.get('acceptedAt', null)
        && newLine.get('pickedUpAt', null) == oldLine.get('pickedUpAt', null);
    }

    function e_0_0(){return resource.data.awbLines.size()>0&&request.resource.data.awbLines.size()>0&&awbDispatchEquals(resource.data.awbLines[0],request.resource.data.awbLines[0]);}
    function e_0_1(){return resource.data.awbLines.size()>0&&request.resource.data.awbLines.size()>1&&awbDispatchEquals(resource.data.awbLines[0],request.resource.data.awbLines[1]);}
    function e_0_2(){return resource.data.awbLines.size()>0&&request.resource.data.awbLines.size()>2&&awbDispatchEquals(resource.data.awbLines[0],request.resource.data.awbLines[2]);}
    function e_0_3(){return resource.data.awbLines.size()>0&&request.resource.data.awbLines.size()>3&&awbDispatchEquals(resource.data.awbLines[0],request.resource.data.awbLines[3]);}
    function e_0_4(){return resource.data.awbLines.size()>0&&request.resource.data.awbLines.size()>4&&awbDispatchEquals(resource.data.awbLines[0],request.resource.data.awbLines[4]);}
    function e_0_5(){return resource.data.awbLines.size()>0&&request.resource.data.awbLines.size()>5&&awbDispatchEquals(resource.data.awbLines[0],request.resource.data.awbLines[5]);}
    function e_0_6(){return resource.data.awbLines.size()>0&&request.resource.data.awbLines.size()>6&&awbDispatchEquals(resource.data.awbLines[0],request.resource.data.awbLines[6]);}
    function e_0_7(){return resource.data.awbLines.size()>0&&request.resource.data.awbLines.size()>7&&awbDispatchEquals(resource.data.awbLines[0],request.resource.data.awbLines[7]);}
    function e_0_8(){return resource.data.awbLines.size()>0&&request.resource.data.awbLines.size()>8&&awbDispatchEquals(resource.data.awbLines[0],request.resource.data.awbLines[8]);}
    function e_0_9(){return resource.data.awbLines.size()>0&&request.resource.data.awbLines.size()>9&&awbDispatchEquals(resource.data.awbLines[0],request.resource.data.awbLines[9]);}
    function e_1_0(){return resource.data.awbLines.size()>1&&request.resource.data.awbLines.size()>0&&awbDispatchEquals(resource.data.awbLines[1],request.resource.data.awbLines[0]);}
    function e_1_1(){return resource.data.awbLines.size()>1&&request.resource.data.awbLines.size()>1&&awbDispatchEquals(resource.data.awbLines[1],request.resource.data.awbLines[1]);}
    function e_1_2(){return resource.data.awbLines.size()>1&&request.resource.data.awbLines.size()>2&&awbDispatchEquals(resource.data.awbLines[1],request.resource.data.awbLines[2]);}
    function e_1_3(){return resource.data.awbLines.size()>1&&request.resource.data.awbLines.size()>3&&awbDispatchEquals(resource.data.awbLines[1],request.resource.data.awbLines[3]);}
    function e_1_4(){return resource.data.awbLines.size()>1&&request.resource.data.awbLines.size()>4&&awbDispatchEquals(resource.data.awbLines[1],request.resource.data.awbLines[4]);}
    function e_1_5(){return resource.data.awbLines.size()>1&&request.resource.data.awbLines.size()>5&&awbDispatchEquals(resource.data.awbLines[1],request.resource.data.awbLines[5]);}
    function e_1_6(){return resource.data.awbLines.size()>1&&request.resource.data.awbLines.size()>6&&awbDispatchEquals(resource.data.awbLines[1],request.resource.data.awbLines[6]);}
    function e_1_7(){return resource.data.awbLines.size()>1&&request.resource.data.awbLines.size()>7&&awbDispatchEquals(resource.data.awbLines[1],request.resource.data.awbLines[7]);}
    function e_1_8(){return resource.data.awbLines.size()>1&&request.resource.data.awbLines.size()>8&&awbDispatchEquals(resource.data.awbLines[1],request.resource.data.awbLines[8]);}
    function e_1_9(){return resource.data.awbLines.size()>1&&request.resource.data.awbLines.size()>9&&awbDispatchEquals(resource.data.awbLines[1],request.resource.data.awbLines[9]);}
    function e_2_0(){return resource.data.awbLines.size()>2&&request.resource.data.awbLines.size()>0&&awbDispatchEquals(resource.data.awbLines[2],request.resource.data.awbLines[0]);}
    function e_2_1(){return resource.data.awbLines.size()>2&&request.resource.data.awbLines.size()>1&&awbDispatchEquals(resource.data.awbLines[2],request.resource.data.awbLines[1]);}
    function e_2_2(){return resource.data.awbLines.size()>2&&request.resource.data.awbLines.size()>2&&awbDispatchEquals(resource.data.awbLines[2],request.resource.data.awbLines[2]);}
