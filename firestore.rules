rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users can read/create their own profile. Only the owner can create it
    // (at sign-up); nobody can change their own role after that. A user can
    // update their own push-notification token; an admin can set a driver's
    // payroll rate (payType/payRate), a customer's billing rate
    // (billType/billRate), or fix a user's display name — nothing else about
    // another user's profile is writable from the client (email/password go
    // through their respective Cloud Functions instead, since those touch
    // the Auth account too). quickbooksCustomerId is written only by the
    // sendQuickBooksInvoice Cloud Function (Admin SDK bypasses these rules).
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (
        (request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["pushToken"])) ||
        (isAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ["payType", "payRate", "billType", "billRate", "name"])));
      allow delete: if false;
    }

    // Drivers can create and read their own trips. Admins can read every trip
    // and toggle a trip's payroll-paid or invoiced status. Trips can't
    // otherwise be edited or deleted directly by clients — deletion only
    // happens through the deleteTrip Cloud Function, which audits it.
    match /trips/{tripId} {
      allow create: if isSignedIn() && request.resource.data.driverId == request.auth.uid;
      allow read: if isSignedIn() &&
        (resource.data.driverId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["paid", "invoiced"]);
      allow delete: if false;
    }

    // Audit trail written only by the deleteTrip Cloud Function (Admin SDK
    // bypasses these rules); admins can review it, nobody can write to it
    // directly from the client.
    match /deletedTrips/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // QuickBooks OAuth tokens — holds a live access/refresh token pair that
    // could act on the whole connected QuickBooks company, so no client
    // (including admins) ever reads or writes it directly. Only the
    // QuickBooks Cloud Functions touch it, via the Admin SDK.
    match /quickbooksAuth/{docId} {
      allow read, write: if false;
    }

    // Customers submit and own their trip requests; admins (Dispatch) can
    // read, create (on a customer's behalf, e.g. a phone-in order) and update
    // every request. A customer may keep editing their own request —
    // including cancelling it — right up until a driver actually starts it
    // (In Progress) or it's Completed, Invoiced or already Cancelled, and
    // can never touch driver assignment. Each AWB line
    // now carries its own driver assignment/status, so drivers no longer
    // write to this collection directly — validating "only my own line in
    // the array changed" isn't expressible in these rules. Instead the
    // assigned driver moves their own lines forward (assigned -> in_progress
    // -> completed) through the startMyAwbLines/completeMyAwbLines Cloud
    // Functions, which use the Admin SDK and do their own per-line auth
    // check in code. Drivers keep read access below so they can still see
    // requests they're assigned to.
    function isOwnTripRequest() {
      return resource.data.customerId == request.auth.uid;
    }

    function isAssignedDriver() {
      return request.auth.uid in resource.data.assignedDriverIds;
    }

    function tripRequestLocked() {
      return resource.data.status in ["in_progress", "completed", "invoiced", "cancelled"];
    }

    function customerFieldsUnchanged() {
      return request.resource.data.assignedDriverIds == resource.data.assignedDriverIds &&
        request.resource.data.assignedDriverNames == resource.data.assignedDriverNames &&
        request.resource.data.customerId == resource.data.customerId &&
        request.resource.data.customerName == resource.data.customerName &&
        request.resource.data.customerEmail == resource.data.customerEmail &&
        request.resource.data.submittedAt == resource.data.submittedAt;
    }

    match /tripRequests/{requestId} {
      allow create: if isSignedIn() && (
        isAdmin() ||
        (request.resource.data.customerId == request.auth.uid &&
          request.resource.data.status == "submitted" &&
          request.resource.data.assignedDriverIds.size() == 0));
      allow read: if isSignedIn() && (isOwnTripRequest() || isAdmin() || isAssignedDriver());
      allow update: if isSignedIn() && (
        isAdmin() ||
        (isOwnTripRequest() && !tripRequestLocked() &&
          customerFieldsUnchanged() &&
          (request.resource.data.status == resource.data.status ||
            request.resource.data.status == "cancelled")));
      allow delete: if false;
    }
  }
}
